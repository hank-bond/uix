{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@uix/api": ["./packages/api/src/index.ts"],
      "@uix/api/*": ["./packages/api/src/*.ts"],
      "@uix/client": ["./packages/client/src/index.ts"],
      "@uix/client/*": ["./packages/client/src/*.ts"],
      "@uix/host": ["./packages/host/src/index.ts"],
      "@uix/host/*": ["./packages/host/src/*.ts"]
    }
  },
  "include": [
    "packages/api/src/**/*.ts",
    "packages/client/src/**/*.ts",
    "packages/client/src/**/*.tsx",
    "packages/host/src/catalog.ts",
    "apps/features/**/workspace/**/*.ts",
    "hosts/server/src/browser/**/*.ts",
    "hosts/server/src/resource-urls.ts",
    "hosts/server/src/websocket-messages.ts",
    "hosts/electron/src/renderer/**/*.ts",
    "hosts/electron/src/renderer/**/*.tsx",
    "hosts/electron/src/channel-transport.ts",
    "src/features/**/workspace/**/*.ts",
    "src/features/**/workspace/**/*.tsx",
    "src/features/**/shared/**/*.ts"
  ]
}
