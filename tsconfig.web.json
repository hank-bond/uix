{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@uix/api": ["./packages/api/src/index.ts"],
      "@uix/api/*": ["./packages/api/src/*.ts"],
      "@uix/client": ["./packages/client/src/index.ts"],
      "@uix/client/*": ["./packages/client/src/*.ts"],
      "#backend/*": ["./src/main/*"],
      "#features/*": ["./src/features/*"],
      "#shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "packages/api/src/**/*.ts",
    "packages/client/src/**/*.ts",
    "packages/client/src/**/*.tsx",
    "apps/features/**/workspace/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/features/**/workspace/**/*.ts",
    "src/features/**/workspace/**/*.tsx",
    "src/features/**/shared/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
